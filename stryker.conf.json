{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "pnpm",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.ts",
    "related": false
  },
  "mutate": [
    "src/client.ts",
    "src/errors.ts",
    "src/format.ts",
    "src/fs.ts",
    "src/inputs.ts",
    "src/main.ts",
    "src/outputs.ts",
    "src/progress.ts",
    "src/sse.ts",
    "src/summary.ts",
    "src/version.ts",
    "src/commands/copy.ts",
    "src/commands/delete.ts",
    "src/commands/download.ts",
    "src/commands/head.ts",
    "src/commands/hide.ts",
    "src/commands/list.ts",
    "src/commands/presign.ts",
    "src/commands/purge.ts",
    "src/commands/retention.ts",
    "src/commands/sync.ts",
    "src/commands/unhide.ts",
    "src/commands/upload.ts",
    "src/commands/verify.ts"
  ],
  "reporters": ["progress", "clear-text", "html", "json"],
  "clearTextReporter": {
    "allowEmojis": false,
    "logTests": false,
    "reportTests": false,
    "reportMutants": false,
    "reportScoreTable": true
  },
  "concurrency": 2,
  "thresholds": {
    "high": 80,
    "low": 70,
    "break": 70
  }
}
