{
  "default_tier": "medium",
  "large_diff_lines": 800,
  "trusted_authors": ["goanpeca", "jeronimodeleon", "sophiecarreras", "ffumero2003"],
  "low_paths": [
    "**/*.md",
    "docs/**",
    "__tests__/**",
    ".changes/unreleased/**",
    ".cspell/**",
    "LICENSE"
  ],
  "medium_paths": [
    "src/**",
    "dist/**",
    "action.yml",
    "package.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "scripts/**"
  ],
  "high_paths": [
    ".github/workflows/**",
    ".github/actions/**",
    ".claude/**",
    "AGENTS.md",
    "CLAUDE.md",
    "GEMINI.md",
    "REVIEW.md",
    "SECURITY.md",
    "RELEASE.md",
    ".github/CODEOWNERS",
    ".github/pull_request_template.md",
    ".github/risk-tiers.json",
    "docs/design-docs/conventions.md",
    "docs/design-docs/review-process.md",
    "docs/design-docs/review-lessons.md",
    "scripts/changelog-check*.mjs",
    "scripts/claude-review-gate*.mjs",
    "scripts/check-release-provenance-policy.mjs",
    "scripts/changelog-release.mjs",
    ".changie.yaml",
    "src/inputs.ts",
    "src/client.ts",
    "src/errors.ts"
  ],
  "always_human_paths": [
    ".github/workflows/**",
    ".github/actions/**",
    ".claude/**",
    "AGENTS.md",
    "CLAUDE.md",
    "GEMINI.md",
    "REVIEW.md",
    "SECURITY.md",
    "RELEASE.md",
    ".github/CODEOWNERS",
    ".github/pull_request_template.md",
    ".github/risk-tiers.json",
    "docs/design-docs/conventions.md",
    "docs/design-docs/review-process.md",
    "docs/design-docs/review-lessons.md",
    "scripts/changelog-check*.mjs",
    "scripts/claude-review-gate*.mjs",
    "scripts/check-release-provenance-policy.mjs",
    "scripts/changelog-release.mjs",
    ".changie.yaml",
    "src/inputs.ts",
    "src/client.ts",
    "src/errors.ts"
  ]
}
